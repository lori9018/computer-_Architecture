class Ball {
    field int x, y; 
    field int length; 
    field int dx, dy; 

    constructor Ball new(int Ax, int Ay, int Alength, int Adx, int Ady) {
        let x = Ax;
        let y = Ay;
        let length = Alength;
        let dx = Adx;
        let dy = Ady;
        do show();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void show() {
        do Screen.setColor(true); 
        do draw();
        return;
    }

    method void hide() {
        do Screen.setColor(false); 
        do draw();
        return;
    }

    method void draw() {
        
        do Screen.drawRectangle(x, y, x + length, y + length);
        return;
    }

// 在 Ball.jack 中
    method void move() {
    do hide(); 

    
    let x = x + dx;
    let y = y + dy;

    
    
    
    if (x < 0) { 
        let x = 0;      
        let dx = -dx;   
    }

    
    if ((x + length) > 511) { 
        let x = 511 - length;
        let dx = -dx;
    }


    if (y < 0) { 
        let y = 0;
        let dy = -dy;    
    }
    
 

    do show(); 
    return;
}
    
  
    method void bounce() {
        let dy = -dy;
        return;
    }
    
   
    method int getLeft() { return x; }
    method int getRight() { return x + length; }
    method int getBottom() { return y + length; }
}