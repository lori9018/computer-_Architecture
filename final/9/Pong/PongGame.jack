class PongGame {
    field Bat bat;
    field Ball ball;
    field int score;

    constructor PongGame new() {
        do Screen.clearScreen();
        
        let bat = Bat.new(230, 229, 50, 10);
        let ball = Ball.new(253, 222, 6, 1, -1); 
        let score = 0;
        return this;
    }

    method void dispose() {
        do bat.dispose();
        do ball.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method void run() {
        var char key;
        var boolean exit;
        let exit = false;

        while (~exit) {
            
            let key = Keyboard.keyPressed();

            if (key = 130) { do bat.moveLeft(); } 
            if (key = 132) { do bat.moveRight(); } 
            if (key = 81)  { let exit = true; } 

            do moveBall(); 
            
            do Sys.wait(10); 
        }
        return;
    }


    method void moveBall() {
    var int ballBottom, batTop;
    var int ballLeft, ballRight, batLeft, batRight;
    

    do ball.move();
    

    let ballBottom = ball.getBottom();
    let batTop = bat.getTop();
    let ballLeft = ball.getLeft();
    let ballRight = ball.getRight();
    let batLeft = bat.getLeft();
    let batRight = bat.getRight();


    if ((ballBottom > batTop) & (ballBottom < (batTop + 4))) {
        if ((ballRight > batLeft) & (ballLeft < batRight)) {
            do ball.bounce(); // 反彈！

        }
    }



    if (ballBottom > 254) {
        do Output.moveCursor(10, 27); 
        do Output.printString("Game Over");
        do Sys.halt(); 
    }
    
    return;
}
}