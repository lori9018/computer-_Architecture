// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    
    Inc16(in=feedback, out=pcInc);

   
    Mux16(a=feedback, b=pcInc, sel=inc, out=w0);

 
    Mux16(a=w0, b=in, sel=load, out=w1);

   
    Mux16(a=w1, b=false, sel=reset, out=pcIn);

   
    Register(in=pcIn, load=true, out=out, out=feedback);
}


計數器-->取得指令的位子
每次執行時並不是只有+1，考慮到會跳行時，需要控制
rest=1 -->重開機
load=1-->將某一值寫入電腦
inc=1 -->正常情況下執行下個指令
其他狀況 -->PC維持不動
多個If，使用多工器控制暫存器